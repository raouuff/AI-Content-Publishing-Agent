# ============================================================
# Part 2 — AI Content Generation & Automated Publishing Agent
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env (see .gitignore).
# ============================================================

# ---- LLM provider (Gemini default; OpenAI swappable) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional: switch to OpenAI instead of Gemini
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Local mock publishing API (mock/wordpress.py, mock/social.py) ----
MOCK_API_BASE=http://127.0.0.1:8001
MOCK_API_PORT=8001

# ---- Storage ----
CONTENT_DB_PATH=content.db
